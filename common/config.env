# EdgeGuard shared settings (NFR-2.3). Read by every component on both Pis.
# Format: KEY=VALUE, comments on their own line only (systemd and Docker
# don't allow comments after a value).

# ---- Hosts ----
HMI_IP=192.168.5.12
SENSEHAT_IP=192.168.5.13
NAS_IP=192.168.5.254
CLASSROOM_SUBNET=192.168.5.0/24
EVENt_SOURCES=192.168.5.13, 127.0.0.1
# Never quarantined (FR-2.4, NFR-3.3); fill in your laptop and the gateway from `ip route show default`
MGMT_HOST_IP=
GATEWAY_IP=

# ---- Ports ----
TELEMETRY_PORT=5005
COMMAND_PORT=5010
EVENT_PORT=5020
ENFORCE_PORT=5030
EDGE_EVENT_PORT=5040
CANARY_PORT=5060
CONTROL_PORT=5070
DASH_RELAY_PORT=5075
NAS_PORT=3306
EVENT_RELAY_PORT=5050

# ---- Thresholds ----
TEMP_ALARM_C=40
HUMIDITY_ALARM_PCT=80
TAMPER_G=1.5
HEARTBEAT_EVERY_S=2
OFFLINE_AFTER_S=6
UNAUTH_CMD_LIMIT=3
UNAUTH_WINDOW_S=60
TEMP_OFFSET_C=17.5
