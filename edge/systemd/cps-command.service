[Unit]
Description=EdgeGuard actuator command service (S2, TCP 5010)
Wants=network-online.target
After=network-online.target
PartOf=cps-edge.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 -m edge.command_service
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2

[Install]
WantedBy=cps-edge.target
