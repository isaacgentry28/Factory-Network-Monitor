[Unit]
Description=EdgeGuard security event reporter (S3 client to HMI:5020)
Wants=network-online.target
After=network-online.target
PartOf=cps-edge.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 -m edge.event_reporter
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=2

[Install]
WantedBy=cps-edge.target
